    VUELOS ||--o{ ASIENTOS : "genera"
    VUELOS ||--o{ RESERVAS : "recibe"
    RESERVAS ||--o{ PASAJEROS : "incluye"
    RESERVAS ||--o{ ASIENTOS : "ocupa"
